# Copy to .env and fill in. NEVER commit the real .env file.

ENVIRONMENT=development            # development | production

# Required in production (generate with the commands below). In development they are auto-generated into data/.dev_*
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SQLite for development; PostgreSQL (e.g. Amazon RDS) in production
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/fabric

COOKIE_SECURE=false                # true behind HTTPS
CONFIDENCE_THRESHOLD=0.60
MAX_UPLOAD_MB=5

# Rate limits per window (seconds)
RATE_WINDOW_SECONDS=60
LOGIN_LIMIT=10
REGISTER_LIMIT=5
UPLOAD_LIMIT=20
ASSISTANT_LIMIT=30

# Optional LLM used ONLY to rephrase retrieved knowledge (leave empty for fully local mode)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Demo data
AUTO_SEED_DEMO=false
DEMO_PASSWORD=DemoPass2026
